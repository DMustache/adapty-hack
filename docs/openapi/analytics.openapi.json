{
  "components": {
    "schemas": {
      "ActualObservation": {
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "minLength": 1,
            "title": "App Id",
            "type": "string"
          },
          "dimensions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Dimensions",
            "type": "object"
          },
          "metric_name": {
            "minLength": 1,
            "title": "Metric Name",
            "type": "string"
          },
          "metric_value": {
            "title": "Metric Value",
            "type": "number"
          },
          "observation_id": {
            "minLength": 1,
            "title": "Observation Id",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "source": {
            "default": "demo",
            "enum": [
              "demo",
              "external"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "observation_id",
          "app_id",
          "metric_name",
          "metric_value",
          "observed_at"
        ],
        "title": "ActualObservation",
        "type": "object"
      },
      "ChurnPredictionResult": {
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "title": "App Id",
            "type": "string"
          },
          "as_of_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of At"
          },
          "churn_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Churn Probability",
            "type": "number"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "predicted_at": {
            "format": "date-time",
            "title": "Predicted At",
            "type": "string"
          },
          "prediction_id": {
            "title": "Prediction Id",
            "type": "string"
          },
          "prediction_source": {
            "enum": [
              "mock",
              "external"
            ],
            "title": "Prediction Source",
            "type": "string"
          },
          "renewal_due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Renewal Due At"
          },
          "renewal_horizon_days": {
            "title": "Renewal Horizon Days",
            "type": "integer"
          },
          "renewal_price_usd": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Renewal Price Usd"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "prediction_id",
          "request_id",
          "app_id",
          "user_id",
          "model_id",
          "model_version",
          "prediction_source",
          "predicted_at",
          "renewal_horizon_days",
          "churn_probability"
        ],
        "title": "ChurnPredictionResult",
        "type": "object"
      },
      "ExperimentAssignment": {
        "properties": {
          "arm": {
            "title": "Arm",
            "type": "string"
          },
          "baseline_renewal_probability": {
            "title": "Baseline Renewal Probability",
            "type": "number"
          },
          "discount_fraction": {
            "title": "Discount Fraction",
            "type": "number"
          },
          "expected_revenue_at_risk_usd": {
            "title": "Expected Revenue At Risk Usd",
            "type": "number"
          },
          "max_discount_exposure_usd": {
            "title": "Max Discount Exposure Usd",
            "type": "number"
          },
          "min_post_offer_renewal_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Post Offer Renewal Probability"
          },
          "plan_type": {
            "enum": [
              "weekly",
              "monthly"
            ],
            "title": "Plan Type",
            "type": "string"
          },
          "renewal_price_usd": {
            "title": "Renewal Price Usd",
            "type": "number"
          },
          "required_absolute_uplift": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Absolute Uplift"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "plan_type",
          "arm",
          "discount_fraction",
          "max_discount_exposure_usd",
          "renewal_price_usd",
          "expected_revenue_at_risk_usd",
          "baseline_renewal_probability"
        ],
        "title": "ExperimentAssignment",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RetentionPlanResult": {
        "properties": {
          "app_id": {
            "title": "App Id",
            "type": "string"
          },
          "assignments": {
            "items": {
              "$ref": "#/components/schemas/ExperimentAssignment"
            },
            "title": "Assignments",
            "type": "array"
          },
          "budget_usd": {
            "title": "Budget Usd",
            "type": "number"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "expected_baseline_revenue_at_risk_usd": {
            "title": "Expected Baseline Revenue At Risk Usd",
            "type": "number"
          },
          "experiment_id": {
            "title": "Experiment Id",
            "type": "string"
          },
          "max_allocated_discount_exposure_usd": {
            "title": "Max Allocated Discount Exposure Usd",
            "type": "number"
          },
          "modeled_discount_uplift": {
            "default": false,
            "title": "Modeled Discount Uplift",
            "type": "boolean"
          },
          "plan_source": {
            "const": "scenario_experiment",
            "default": "scenario_experiment",
            "title": "Plan Source",
            "type": "string"
          },
          "request_fingerprint": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Request Fingerprint",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "unallocated_budget_usd": {
            "title": "Unallocated Budget Usd",
            "type": "number"
          }
        },
        "required": [
          "experiment_id",
          "app_id",
          "request_fingerprint",
          "created_at",
          "budget_usd",
          "max_allocated_discount_exposure_usd",
          "expected_baseline_revenue_at_risk_usd",
          "unallocated_budget_usd",
          "assignments",
          "disclaimer"
        ],
        "title": "RetentionPlanResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
